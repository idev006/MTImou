@echo off
REM Starter local settings for MTImou.
REM This file is safe to commit as an example because it contains placeholders only.
REM setup_windows.bat copies it to camera.env.bat when your local file does not exist.

REM ---------------------------------------------------------------------------
REM Required: fill camera identity and passwords
REM ---------------------------------------------------------------------------

set DH_P2P_REPO_DIR=F:\programming\python\MTImou\dh-p2p

set IMOU_CAMERA_SN=YOUR_CAMERA_1_SN
set IMOU_CAMERA2_SN=YOUR_CAMERA_2_SN
set IMOU_CAMERA_USERNAME=admin

REM Recommended N-camera password naming:
set IMOU_CAM_CAM1_PASSWORD=YOUR_CAMERA_1_PASSWORD
set IMOU_CAM_CAM2_PASSWORD=YOUR_CAMERA_2_PASSWORD

REM Legacy names still work for compatibility:
REM set IMOU_CAMERA_PASSWORD=YOUR_CAMERA_1_PASSWORD
REM set IMOU_CAMERA2_PASSWORD=YOUR_CAMERA_2_PASSWORD

REM ---------------------------------------------------------------------------
REM Optional: remote access
REM ---------------------------------------------------------------------------

REM Shared DDNS hostname for the house. Leave blank if you do not use DDNS yet.
set IMOU_DDNS_HOST=YOUR-HOSTNAME.ddns.net

REM Runtime mode:
REM   auto   = prefer LAN, then DDNS, then public
REM   lan    = force LAN
REM   ddns   = force DDNS
REM   public = force public IP/port
set IMOU_TARGET_MODE=auto

REM ---------------------------------------------------------------------------
REM Optional: official Imou Open API
REM ---------------------------------------------------------------------------

set IMOU_APP_ID=YOUR_OPENAPI_APP_ID
set IMOU_APP_SECRET=YOUR_OPENAPI_APP_SECRET
set IMOU_OPENAPI_DC=sg
REM Optional override full domain:
REM set IMOU_OPENAPI_DOMAIN=openapi-sg.easy4ip.com
set IMOU_OPENAPI_CHANNEL_ID=0
set IMOU_OPENAPI_STREAM_ID=0

REM ---------------------------------------------------------------------------
REM Stable runtime defaults
REM ---------------------------------------------------------------------------

set IMOU_CAMERA_TYPE=0
set IMOU_FORCE_RELAY=1
set IMOU_RTSP_INCLUDE_AUTH=1
set IMOU_RTSP_SUBTYPE=0
set IMOU_RTSP_HOST=127.0.0.1
set IMOU_RTSP_PORT=554
set IMOU_RTSP_CHANNEL=1

REM ---------------------------------------------------------------------------
REM Viewer display defaults (can also be changed from the UI)
REM ---------------------------------------------------------------------------

set IMOU_SINGLE_OVERLAY_TITLE_SCALE=1.04
set IMOU_SINGLE_OVERLAY_META_SCALE=0.92
set IMOU_SINGLE_OVERLAY_SMALL_SCALE=0.80
set IMOU_MULTI_OVERLAY_TITLE_SCALE=0.56
set IMOU_MULTI_OVERLAY_META_SCALE=0.48
set IMOU_MULTI_OVERLAY_SMALL_SCALE=0.44
